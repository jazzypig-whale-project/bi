# .env — ТОЛЬКО СЕКРЕТЫ. Скопировать в .env и заполнить. .env в .gitignore — в git НЕ коммитить.
# Вся остальная конфигурация (образы/теги, порты, домен, MB_SITE_URL, лимиты памяти, STAGING) —
# дефолты в docker-compose*.yaml (${VAR:-...}); переопределять там или через окружение, не здесь.

# --- Метадата-БД Metabase (ОТДЕЛЬНАЯ, НЕ app-БД orchestrator!) ---
MB_DB_PASS=                    # ОБЯЗАТЕЛЬНО (сильный пароль). Только для bi-postgres, не для app-БД.

# --- Шифрование бэкапа метадаты (AES-256; это НЕ пароль БД) ---
BI_BACKUP_ENCRYPT_PASSWORD=    # ОБЯЗАТЕЛЬНО для make backup / restore

# --- Spaceship API (DNS-01, нужен только в prod-режиме для выпуска серта). Из vault инфра-репо. ---
SPACESHIP_API_KEY=
SPACESHIP_API_SECRET=

# --- ./mbc (Metabase as code) — подключение к живому инстансу; см. docs/metabase-as-code.md ---
# METABASE_BASE_URL сам по себе не секрет, но живёт здесь: load_config() читает только .env.
# ⚠ Без хвостовой "/" — иначе nginx отвечает "400 Ambiguous URI empty segment" на каждый запрос.
METABASE_BASE_URL=                 # ОБЯЗАТЕЛЬНО, напр. https://bi.apple-certificate.solutions:8443
METABASE_BASIC_USERNAME=           # ОБЯЗАТЕЛЬНО, basic-auth логин перед nginx
METABASE_BASIC_PASSWORD=           # ОБЯЗАТЕЛЬНО, basic-auth пароль перед nginx
METABASE_API_KEY=                  # ОБЯЗАТЕЛЬНО, API-ключ Metabase (X-API-KEY)
