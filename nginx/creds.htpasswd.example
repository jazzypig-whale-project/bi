# Образец. Реальный файл — nginx/creds.htpasswd (в .gitignore, в git НЕ коммитить).
# Сгенерировать: make htpasswd USER=admin   (пароль спросит скрыто, не в history/ps)
# Вручную (без make): printf '%s:%s\n' admin "$(openssl passwd -apr1)" > nginx/creds.htpasswd
# Формат — apr1/bcrypt (nginx auth_basic). Пример строки (пароль-плейсхолдер, НЕ рабочий):
# admin:$apr1$xxxxxxxx$xxxxxxxxxxxxxxxxxxxxxx
