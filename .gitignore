# Секреты — НИКОГДА в git (см. CLAUDE.md, железное условие)
.env
*.env
!.env.example
nginx/creds.htpasswd
!nginx/creds.htpasswd.example
# TLS: креды Spaceship (секрет) и рендерённый per-env vhost — не в git; шаблоны/примеры — да
nginx/spaceship.ini
nginx/user_conf.d/bi.conf
*.key
*.pem
secrets/

# Бэкапы метадата-БД (могут содержать данные) + ключ шифрования
*.dump
*.dump.enc
backups/

# Данные Postgres-метаданных (том)
pgdata/
data/

# Мусор
*.log
.DS_Store

# Metabase-as-code (mbc/mbcode) — Python tooling, не переносимо между путями
.venv/
__pycache__/
*.pyc
.pytest_cache/

# .state/ is intentionally NOT ignored. It maps logical keys (collection,
# card, dashboard, tab, dashcard) to server-assigned ids and entity_ids.
# If this file is lost, the next apply cannot recognize existing entities
# and will recreate everything as duplicates. Commit it.
